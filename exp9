
# LSTM Text Generation using Shakespeare Corpus

import tensorflow as tf
import numpy as np
import urllib.request
import matplotlib.pyplot as plt

from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, LSTM, Dense, Dropout

# 1. Download Shakespeare text corpus
url = "https://www.gutenberg.org/cache/epub/100/pg100.txt"
text = urllib.request.urlopen(url).read().decode("utf-8")
text = text[:500000].lower()

print("Corpus length:", len(text), "characters")

# 2. Tokenize text
tokenizer = Tokenizer()
tokenizer.fit_on_texts([text])
total_words = len(tokenizer.word_index) + 1

sequences = []
for line in text.split("\n"):
    tokens = tokenizer.texts_to_sequences([line])[0]
    for i in range(2, len(tokens) + 1):
        sequences.append(tokens[:i])

# Limit samples for faster Colab execution
sequences = sequences[:30000]
max_len = min(max(len(s) for s in sequences), 20)

sequences = pad_sequences(
    sequences, maxlen=max_len, padding="pre"
)

X = sequences[:, :-1]
y = sequences[:, -1]

# 3. Build LSTM model
model = Sequential([
    Embedding(total_words, 64, input_length=max_len - 1),
    LSTM(128),
    Dropout(0.2),
    Dense(total_words, activation="softmax")
])

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

# 4. Train model
history = model.fit(
    X, y,
    epochs=5,
    batch_size=128,
    validation_split=0.1,
    verbose=1
)

# 5. Generate text
def generate_text(seed, next_words=50, temperature=0.8):
    result = seed.lower()

    for _ in range(next_words):
        tokens = tokenizer.texts_to_sequences([result])[0]
        tokens = pad_sequences(
            [tokens[-(max_len - 1):]],
            maxlen=max_len - 1,
            padding="pre"
        )

        probabilities = model.predict(tokens, verbose=0)[0]
        probabilities = np.log(probabilities + 1e-8) / temperature
        probabilities = np.exp(probabilities - np.max(probabilities))
        probabilities /= probabilities.sum()

        next_word = np.random.choice(
            len(probabilities), p=probabilities
        )

        word = tokenizer.index_word.get(next_word, "")
        if not word:
            continue

        result += " " + word

    return result

# 6. Generate sample text
seed_text = "to be or not to be"
generated = generate_text(seed_text, 50)

print("\nGENERATED TEXT:\n")
print(generated)

# 7. Evaluate model
train_loss = history.history["loss"][-1]
perplexity = np.exp(min(train_loss, 20))

print("\nMODEL EVALUATION")
print("Final Training Loss:", round(train_loss, 4))
print("Training Perplexity:", round(perplexity, 2))
print("Vocabulary Size:", total_words)
print("Generated Words:", len(generated.split()))

# 8. Plot training loss
plt.plot(history.history["loss"], label="Training Loss")
plt.plot(history.history["val_loss"], label="Validation Loss")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.title("LSTM Text Generation Training")
plt.legend()
plt.grid()
plt.show()

print("\nResult: LSTM trained and Shakespeare-style text generated.")
