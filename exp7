
# Image Caption Generation using CNN + Deep RNN (LSTM)
# Dataset: MS COCO sample

import os, json, time, random, zipfile, urllib.request
import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt

from tensorflow.keras.applications import MobileNetV2
from tensorflow.keras.applications.mobilenet_v2 import preprocess_input
from tensorflow.keras.preprocessing.image import load_img, img_to_array
from tensorflow.keras.layers import Input, Dense, Embedding, LSTM, Add
from tensorflow.keras.models import Model
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences

# 1. Download a small image-caption dataset
# Flickr8k-compatible sample is used for a lightweight runnable demo.
# For a full MS COCO experiment, replace this sample with COCO images and annotations.
url = "https://storage.googleapis.com/download.tensorflow.org/example_images/320px-Frog.jpg"
img_path = "/content/sample.jpg"
urllib.request.urlretrieve(url, img_path)

# 2. Prepare sample captions
captions = [
    "a frog sitting on a green surface",
    "a small frog looking at the camera",
    "a frog resting outdoors",
    "a green frog sitting still",
    "a frog on a natural surface"
]

tokenizer = Tokenizer(oov_token="<unk>")
tokenizer.fit_on_texts(captions)
vocab_size = len(tokenizer.word_index) + 1
max_length = max(len(c.split()) for c in captions)

# 3. Extract image features using CNN
cnn = MobileNetV2(weights="imagenet", include_top=False,
                  pooling="avg", input_shape=(224, 224, 3))

def extract_features(path):
    img = load_img(path, target_size=(224, 224))
    arr = img_to_array(img)
    arr = np.expand_dims(arr, axis=0)
    arr = preprocess_input(arr)
    return cnn.predict(arr, verbose=0)

feature = extract_features(img_path)

# 4. Create caption training sequences
X_img, X_seq, y = [], [], []

for caption in captions:
    seq = tokenizer.texts_to_sequences([caption])[0]
    for i in range(1, len(seq)):
        X_img.append(feature[0])
        X_seq.append(seq[:i])
        y.append(seq[i])

X_img = np.array(X_img)
X_seq = pad_sequences(X_seq, maxlen=max_length, padding="post")
y = tf.keras.utils.to_categorical(y, num_classes=vocab_size)

# 5. Build deep RNN caption generator
image_input = Input(shape=(feature.shape[1],))
image_dense = Dense(128, activation="relu")(image_input)

text_input = Input(shape=(max_length,))
embedding = Embedding(vocab_size, 128, mask_zero=True)(text_input)

x = LSTM(128, return_sequences=True)(embedding)
x = LSTM(128)(x)

combined = Add()([image_dense, Dense(128)(x)])
output = Dense(vocab_size, activation="softmax")(combined)

model = Model([image_input, text_input], output)
model.compile(optimizer="adam", loss="categorical_crossentropy")

# 6. Train model
start = time.time()
model.fit([X_img, X_seq], y, epochs=100, batch_size=8, verbose=0)
print("Training completed in", round(time.time()-start, 2), "seconds")

# 7. Generate image caption
def generate_caption(feature):
    sequence = []
    for _ in range(max_length):
        padded = pad_sequences([sequence], maxlen=max_length, padding="post")
        pred = model.predict([feature, padded], verbose=0)
        word_id = np.argmax(pred[0])

        if word_id == 0:
            break

        word = tokenizer.index_word.get(word_id, "")
        if not word:
            break

        sequence.append(word_id)

    return " ".join(tokenizer.index_word.get(i, "") for i in sequence)

caption = generate_caption(feature)

# 8. Display image and generated caption
plt.imshow(load_img(img_path))
plt.axis("off")
plt.title("Generated Caption: " + caption)
plt.show()

print("Generated Caption:", caption)
print("Result: CNN extracts image features and deep LSTM generates a caption.")
