# ============================================================
# EX 3: COMPARISON OF SGD WITH MOMENTUM VS ADAM OPTIMIZER
# Dataset: CIFAR-10
# Model: Multi-Layer Perceptron (MLP)
# ============================================================

# Step 1: Import Libraries
import torch
import torch.nn as nn
import torch.optim as optim
import torchvision
import torchvision.transforms as transforms
import matplotlib.pyplot as plt

# ------------------------------------------------------------
# Step 2: Check Device
# ------------------------------------------------------------
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

print("Using device:", device)

# ------------------------------------------------------------
# Step 3: Load CIFAR-10 Dataset
# ------------------------------------------------------------

transform = transforms.Compose([
    transforms.ToTensor(),
    transforms.Normalize(
        (0.5, 0.5, 0.5),
        (0.5, 0.5, 0.5)
    )
])

trainset = torchvision.datasets.CIFAR10(
    root="./data",
    train=True,
    download=True,
    transform=transform
)

# DataLoader
trainloader = torch.utils.data.DataLoader(
    trainset,
    batch_size=128,
    shuffle=True,
    num_workers=2,
    pin_memory=True if torch.cuda.is_available() else False
)

print("Dataset loaded successfully!")
print("Number of training images:", len(trainset))

# ------------------------------------------------------------
# Step 4: Define MLP Model
# ------------------------------------------------------------

class MLP(nn.Module):

    def __init__(self):
        super(MLP, self).__init__()

        self.flatten = nn.Flatten()

        self.network = nn.Sequential(
            nn.Linear(3 * 32 * 32, 256),
            nn.ReLU(),
            nn.Linear(256, 10)
        )

    def forward(self, x):
        x = self.flatten(x)
        return self.network(x)


# ------------------------------------------------------------
# Step 5: Training Function
# ------------------------------------------------------------

def train_model(model, optimizer, epochs=10):

    model = model.to(device)

    loss_function = nn.CrossEntropyLoss()

    losses = []
    accuracies = []

    for epoch in range(epochs):

        model.train()

        total_loss = 0.0
        correct = 0
        total = 0

        for images, labels in trainloader:

            images = images.to(device)
            labels = labels.to(device)

            # Forward propagation
            outputs = model(images)

            # Calculate loss
            loss = loss_function(outputs, labels)

            # Clear old gradients
            optimizer.zero_grad()

            # Backpropagation
            loss.backward()

            # Update weights
            optimizer.step()

            # Calculate total loss
            total_loss += loss.item()

            # Calculate accuracy
            _, predicted = torch.max(outputs, 1)

            total += labels.size(0)
            correct += (predicted == labels).sum().item()

        # Average loss
        average_loss = total_loss / len(trainloader)

        # Accuracy
        accuracy = 100.0 * correct / total

        losses.append(average_loss)
        accuracies.append(accuracy)

        print(
            f"Epoch [{epoch+1}/{epochs}] "
            f"Loss: {average_loss:.4f} "
            f"Accuracy: {accuracy:.2f}%"
        )

    return losses, accuracies


# ------------------------------------------------------------
# Step 6: Train Using SGD + Momentum
# ------------------------------------------------------------

print("\n" + "=" * 50)
print("TRAINING USING SGD + MOMENTUM")
print("=" * 50)

# Create model
model_sgd = MLP()

# SGD optimizer with momentum
optimizer_sgd = optim.SGD(
    model_sgd.parameters(),
    lr=0.01,
    momentum=0.9
)

# Train
loss_sgd, accuracy_sgd = train_model(
    model_sgd,
    optimizer_sgd,
    epochs=10
)


# ------------------------------------------------------------
# Step 7: Train Using Adam
# ------------------------------------------------------------

print("\n" + "=" * 50)
print("TRAINING USING ADAM")
print("=" * 50)

# Create another model
model_adam = MLP()

# Adam optimizer
optimizer_adam = optim.Adam(
    model_adam.parameters(),
    lr=0.001
)

# Train
loss_adam, accuracy_adam = train_model(
    model_adam,
    optimizer_adam,
    epochs=10
)


# ------------------------------------------------------------
# Step 8: Display Final Results
# ------------------------------------------------------------

print("\n" + "=" * 50)
print("FINAL COMPARISON")
print("=" * 50)

print(
    f"SGD + Momentum -> "
    f"Final Loss: {loss_sgd[-1]:.4f}, "
    f"Final Accuracy: {accuracy_sgd[-1]:.2f}%"
)

print(
    f"Adam           -> "
    f"Final Loss: {loss_adam[-1]:.4f}, "
    f"Final Accuracy: {accuracy_adam[-1]:.2f}%"
)


# ------------------------------------------------------------
# Step 9: Plot Loss Comparison
# ------------------------------------------------------------

epochs_range = range(1, 11)

plt.figure(figsize=(8, 5))

plt.plot(
    epochs_range,
    loss_sgd,
    marker="o",
    label="SGD + Momentum"
)

plt.plot(
    epochs_range,
    loss_adam,
    marker="o",
    label="Adam"
)

plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.title("Loss Comparison: SGD + Momentum vs Adam")
plt.xticks(epochs_range)
plt.grid(True)
plt.legend()

plt.show()


# ------------------------------------------------------------
# Step 10: Plot Accuracy Comparison
# ------------------------------------------------------------

plt.figure(figsize=(8, 5))

plt.plot(
    epochs_range,
    accuracy_sgd,
    marker="o",
    label="SGD + Momentum"
)

plt.plot(
    epochs_range,
    accuracy_adam,
    marker="o",
    label="Adam"
)

plt.xlabel("Epoch")
plt.ylabel("Accuracy (%)")
plt.title("Accuracy Comparison: SGD + Momentum vs Adam")
plt.xticks(epochs_range)
plt.grid(True)
plt.legend()

plt.show()


# ------------------------------------------------------------
# Step 11: Bar Chart of Final Performance
# ------------------------------------------------------------

plt.figure(figsize=(7, 5))

optimizers = ["SGD + Momentum", "Adam"]
final_accuracy = [accuracy_sgd[-1], accuracy_adam[-1]]

plt.bar(optimizers, final_accuracy)

plt.ylabel("Accuracy (%)")
plt.title("Final Accuracy Comparison")
plt.ylim(0, 100)

for i, value in enumerate(final_accuracy):
    plt.text(
        i,
        value + 1,
        f"{value:.2f}%",
        ha="center"
    )

plt.show()

print("\nExperiment completed successfully!")
